; model1.hints -- names for documented TRS-80 Model I Level II entry points
; and RAM locations, the disk system's file entries, and how two restarts
; behave, for listings of programs that use them:
;
;     python3 -m z80.trace PROG.cmd --hints hints/model1.hints
;
; Opt-in, never read by default.  Every address and what it is comes from
; published documentation; the descriptions are our own words.  Where
; Radio Shack or another source published a name it is used; where none
; did, the name is descriptive (marked "coined").
;
; Sources, cited as KEY pPAGE (the page of the scanned book, not the
; printed folio):
;   L2   Level II BASIC Reference Manual, Radio Shack, 1979 (USR chapter,
;        LPRINT, Appendix D memory map)
;   M3   Model III Operation and BASIC Language Reference Manual, Tandy,
;        1980, "Summary of Important ROM Addresses" -- Radio Shack's names;
;        RRD states these entries are the same on the Model I
;   MP   Level II ROM Reference Manual, Micro Products, 1980
;   RRD  TRS-80 ROM Routines Documented, The Alternate Source, 1983
;   FV   Microsoft BASIC Decoded & Other Mysteries, James Farvour, 1981
;   SAMS TRS-80 Assembly Language Made Simple, Howard W. Sams, 1982
;   PH   TRS-80 Assembly Language, Hubert S. Howe Jr., Prentice-Hall, 1981
;        (the TRSDOS file entries)

; ---- the restarts and CPU vectors
label   0000  RESET     ; M3 p92; MP p6; RRD p56
comment 0000  power-up and reset entry
label   0008  SYNCHK    ; coined.  MP p6; FV p29; RRD p56
comment 0008  RST 08H: (HL) must be the byte after the RST, else SN error; then as RST 10H
label   0010  NXTCHR    ; coined.  MP p6; FV p29; RRD p56
comment 0010  RST 10H: HL to the next non-blank character; C set for a digit, Z at end of statement
label   0018  CPDEHL    ; coined.  MP p7; FV p29; RRD p57
comment 0018  RST 18H: compare HL with DE, unsigned; Z equal, C if HL is lower
label   0020  TSTTYP    ; coined.  MP p7; FV p29; RRD p57
comment 0020  RST 20H: test the type of the number in the accumulator (40AFH)
label   0028  DOSVEC    ; coined.  MP p7; FV p30; RRD p57
comment 0028  RST 28H: through the vector at 400CH; DOS requests and BREAK
label   0030  DBGVEC    ; coined.  MP p7; FV p30; RRD p57
comment 0030  RST 30H: through the vector at 400FH; DOS DEBUG
label   0038  INTVEC    ; coined.  MP p8; FV p30; RRD p57
comment 0038  RST 38H and the mode 1 interrupt: through the vector at 4012H
label   0066  NMI       ; coined.  MP p8; RRD p59
comment 0066  non-maskable interrupt (the RESET button); not called by programs

; ---- keyboard, video, printer
label   002B  KBCHAR    ; M3 p92; MP p7; RRD p17; FV p17
comment 002B  scan the keyboard once: A = the key, or 0
label   0033  VDCHAR    ; M3 p92; MP p7; RRD p19; FV p18
comment 0033  display the character in A at the cursor
label   003B  PRCHAR    ; M3 p92; MP p8; RRD p20; FV p19
comment 003B  send the character in A to the printer
label   0040  KBLINE    ; M3 p92; RRD p18; FV p65
comment 0040  read a line from the keyboard into the buffer at HL
label   0049  KBWAIT    ; M3 p92; MP p8; RRD p18; FV p18
comment 0049  wait for a key: A = the key
label   0060  DELAY     ; M3 p92; MP p8; RRD p58; FV p66
comment 0060  delay loop counted by BC
label   01C9  VDCLS     ; M3 p92; MP p9; RRD p20; FV p19
comment 01C9  clear the screen and home the cursor
label   032A  DSPCHR    ; SAMS p97; MP p11; RRD p15; FV p79
comment 032A  output A to video, printer or tape, chosen by the flag at 409CH
label   28A7  OUTLIN    ; SAMS p97; MP p25; RRD p16; FV p33
comment 28A7  output the string at HL to the device chosen by 409CH

; ---- cassette
label   01F8  CSOFF     ; M3 p92; MP p10; RRD p21
comment 01F8  cassette motor off
label   0212  DEFCAS    ; SAMS p127; MP p10; RRD p22; FV p20
comment 0212  select the cassette drive in A and start its motor
label   0235  CSIN      ; M3 p92; MP p10; RRD p22; FV p20
comment 0235  read a byte from tape into A
label   0264  CSOUT     ; M3 p92; MP p10; RRD p22; FV p20
comment 0264  write the byte in A to tape
label   0287  CSHWR     ; M3 p92; MP p10; RRD p22; FV p77
comment 0287  write the leader and sync byte (drive already on)
label   0296  CSHIN     ; M3 p92; MP p11; RRD p22; FV p20
comment 0296  find the leader and sync byte on tape

; ---- BASIC
label   01D3  RANDOM    ; MP p10; FV p27; RRD p34
comment 01D3  RANDOM: reseed the random number generator
label   0A7F  GETARG    ; L2 p105; MP p17; FV p21; RRD p36
comment 0A7F  USR: the argument into HL
label   0A9A  PUTANS    ; L2 p105; MP p17; RRD p38
comment 0A9A  USR: return HL to BASIC as an integer
label   1A19  READY     ; M3 p92; MP p20; FV p16
comment 1A19  back to BASIC's command level

; ---- the disk system's file entries (TRSDOS on the Model I): there only
; under DOS, each takes the file's control block in DE and returns Z on
; success, else NZ with the error code in A (PH p152)
label   4420  INIT      ; PH p152
comment 4420  DOS: open a file, creating it if it does not exist
label   4424  OPEN      ; PH p152; FV p58
comment 4424  DOS: open an existing file
label   4428  CLOSE     ; PH p152
comment 4428  DOS: close a file
label   442C  KILL      ; PH p152
comment 442C  DOS: kill a file
label   4436  READ      ; PH p152; FV p58
comment 4436  DOS: read a record
label   4439  WRITE     ; PH p152
comment 4439  DOS: write a record
label   443C  VERF      ; PH p152
comment 443C  DOS: write a record and verify it
label   4442  POSN      ; PH p152
comment 4442  DOS: position a file at the logical record in BC

; ---- how two restarts and READY change the flow
inline  0008  1         ; RRD p56: returns past the byte after the RST 08H
noreturn 0000 rst       ; RRD p56: RST 0 restarts the machine.  Not CALL
                        ; 0000H: programs patch that placeholder at run time
noreturn 1A19           ; M3 p92; MP p20; FV p16: READY is BASIC's command
                        ; level, so a CALL to it never comes back

; ---- RAM locations (var: names (nn) operands only, never the program's
; own bytes).  Names marked "Sams" are Sams' Appendix D mnemonics, VIDEO
; is Radio Shack's, PBUFF is Farvour's; the rest are coined.  A pointer or vector is named at
; its first byte.

; video memory
var     3C00  VIDEO     ; L2 p163; L2 p104; SAMS p175; MP p28
comment 3C00  video memory, 3C00H-3FFFH: 16 lines of 64

; the restart vectors, each a 3-byte jump
var     4000  RST08V    ; coined.  FV p48; MP p28; RRD p69
comment 4000  vector for RST 08H
var     4003  RST10V    ; coined.  FV p48 (MP p28 misprints 4001)
comment 4003  vector for RST 10H
var     4006  RST18V    ; coined.  FV p48; MP p28
comment 4006  vector for RST 18H
var     4009  RST20V    ; coined.  FV p48; MP p28
comment 4009  vector for RST 20H
var     400C  RST28V    ; coined.  FV p48; MP p28
comment 400C  vector for RST 28H: a RET without DOS
var     400F  RST30V    ; coined.  FV p48; MP p28
comment 400F  vector for RST 30H: a RET without DOS
var     4012  RST38V    ; coined.  FV p48; MP p28; SAMS p73
comment 4012  vector for RST 38H and the mode 1 interrupt

; the device control blocks
var     4015  KIDCB     ; coined.  FV p48; L2 p164; RRD p13
comment 4015  keyboard device control block, 8 bytes
var     4016  KIDRV     ; coined.  MP p29; RRD p13; SAMS p73
comment 4016  keyboard driver address
var     401D  DODCB     ; coined.  FV p48; L2 p164; RRD p13
comment 401D  video device control block, 8 bytes
var     401E  VIDDRA    ; Sams.  SAMS p175; MP p29; RRD p13
comment 401E  video driver address
var     4020  CCRPOS    ; Sams.  SAMS p175; MP p29; L2 p164; RRD p13
comment 4020  cursor address in video memory
var     4022  CURCHR    ; coined.  L2 p164; RRD p13; FV p50
comment 4022  the character under the cursor
var     4025  PRDCB     ; coined.  FV p48; L2 p164; RRD p13
comment 4025  printer device control block, 8 bytes
var     4026  PRDRV     ; coined.  MP p29; RRD p13; SAMS p73
comment 4026  printer driver address
var     4028  LPPAGE    ; coined.  L2 p124; RRD p13; RRD p14; MP p29
comment 4028  printer lines per page, plus one
var     4029  LPCTRA    ; Sams.  SAMS p175; L2 p124; RRD p13; RRD p14
comment 4029  lines printed on this page

; keyboard and port FFH
var     4036  KBWORK    ; coined.  MP p30; RRD p69; RRD p70; FV p48
comment 4036  keyboard scan work area, 7 bytes: the rows last seen
var     403D  PORTFF    ; coined.  RRD p70; SAMS p73; MP p30; FV p48
comment 403D  the bits last sent to port FFH: bit 3 32-character mode, bit 2 cassette motor

; routines and constants BASIC copies into RAM at power-up
var     4080  DIVSUB    ; coined.  RRD p70; FV p48; SAMS p73
comment 4080  subtraction routine used by division, 4080H-408DH, patched before each call

; BASIC's communications region
var     408E  USRADR    ; coined.  L2 p102; MP p30; RRD p71; FV p49; SAMS p73
comment 408E  USR entry address
var     4090  RNDMUL    ; coined.  RRD p71; SAMS p73 (FV p49, FV p68 call it the seed)
comment 4090  RND's multiplier constant, mantissa, 3 bytes
var     4093  INPSUB    ; coined.  RRD p71; SAMS p73; MP p30
comment 4093  IN A,(n) and RET for INP: the port at 4094H
var     4096  OUTSUB    ; coined.  RRD p71; SAMS p73; MP p30
comment 4096  OUT (n),A and RET for OUT: the port at 4097H
var     4099  INKEYB    ; coined.  RRD p71; SAMS p73; MP p30; FV p49
comment 4099  INKEY$ buffer: the last key seen, or 0
var     409A  ERRCOD    ; coined.  RRD p71; SAMS p73; MP p30
comment 409A  error code (ERR, RESUME)
var     409B  LPPOSC    ; Sams.  SAMS p175; RRD p71; MP p30
comment 409B  characters printed on the printer line
var     409C  DTF       ; Sams.  SAMS p175; MP p30; RRD p72; FV p68
comment 409C  output device: 0 video, 1 printer, FFH tape
var     409D  VIDLEN    ; coined.  RRD p72; SAMS p73; FV p49
comment 409D  video line width for printing numbers: 64
var     409E  ZONLIM    ; coined.  RRD p72; SAMS p73; FV p49
comment 409E  last print zone for a comma: 48, four zones
var     40A0  STRBEG    ; coined.  RRD p72; MP p30; SAMS p73; FV p49
comment 40A0  start of string space
var     40A2  CURLIN    ; coined.  RRD p72; MP p30; SAMS p73; FV p68
comment 40A2  line number executing; FFFFH in direct mode
var     40A4  PRGBEG    ; coined.  RRD p72; MP p30; SAMS p73; FV p46
comment 40A4  start of the BASIC program
var     40A6  CCPPTR    ; Sams.  SAMS p175; RRD p72; MP p31; FV p79
comment 40A6  cursor column on the video line (POS)
var     40A7  BUFPTR    ; Sams.  SAMS p175; RRD p72; MP p31; FV p49
comment 40A7  input buffer address
var     40AA  RNDSED    ; coined.  RRD p73; MP p31; SAMS p73; FV p49
comment 40AA  random number seed, 3 bytes
var     40AF  NTF1      ; Sams.  SAMS p174; MP p31; RRD p73; FV p49
comment 40AF  type of the number in FPA1: 2 integer, 3 string, 4 single, 8 double
var     40B1  MEMTOP    ; coined.  RRD p73; MP p31; FV p49; SAMS p74
comment 40B1  top of BASIC memory: the last usable byte
var     40D6  STRFRE    ; coined.  RRD p74; MP p31; SAMS p74; FV p49
comment 40D6  next free byte in string space (strings grow down)
var     40DF  SYSENT    ; coined.  RRD p74; RRD p75; MP p31; SAMS p74; FV p49
comment 40DF  entry address of the last SYSTEM tape; also a work pointer
var     40E1  AUTOFL    ; coined.  RRD p75; MP p31; SAMS p74
comment 40E1  AUTO flag: 0 off
var     40EA  ERRLIN    ; coined.  RRD p75; SAMS p74; FV p49; MP p32
comment 40EA  line number of the last error (ERL)
var     40F0  ONERRA    ; coined.  RRD p75; SAMS p74; FV p49
comment 40F0  ON ERROR GOTO address, or 0
var     40F2  ERRFLG    ; coined.  RRD p75; SAMS p74; FV p49
comment 40F2  error flag: FFH after an error, 0 after RESUME
var     40F9  SIMVAR    ; coined.  RRD p75; MP p32; FV p46; FV p47
comment 40F9  start of simple variables: the end of the program
var     40FB  ARYVAR    ; coined.  RRD p76; MP p32; FV p47; SAMS p74
comment 40FB  start of arrays
var     40FD  FREPTR    ; coined.  RRD p76; MP p32; SAMS p74; FV p49
comment 40FD  end of arrays: the start of free memory
var     40FF  DATPTR    ; coined.  RRD p76; MP p32; FV p49
comment 40FF  where READ looks for the next DATA item
var     4101  DEFTBL    ; coined.  RRD p76; FV p46; FV p49; SAMS p74; MP p32
comment 4101  default type for each letter A-Z, 26 bytes
var     411B  TRONFL    ; coined.  RRD p76; SAMS p74; MP p32; FV p49
comment 411B  trace flag: 0 off, AFH on
var     411D  FPA1      ; Sams.  SAMS p174; MP p32; RRD p77; FV p49
comment 411D  numeric accumulator, 411DH-4124H (an integer at 4121H)
var     4127  FPA2      ; Sams.  SAMS p174; MP p32; RRD p77
comment 4127  second numeric accumulator, 4127H-412EH
var     4130  PBUFF     ; Farvour.  FV p49; RRD p77 (MP p32 differs)
comment 4130  number-to-text buffer for PRINT, 4130H-4149H
var     41E8  INPBUF    ; Sams.  SAMS p175; RRD p79; MP p34
comment 41E8  BASIC's input and output line buffer, 256 bytes
var     42E9  PGMORG    ; coined.  MP p34; SAMS p74; L2 p163
comment 42E9  where a Level II program starts without DOS
